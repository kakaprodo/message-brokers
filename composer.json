{
    "name": "kakaprodo/message-broker",
    "description": "A php and laravel package that simplifies rabbitmq, kafka api integration.",
    "type": "library",
    "keywords": [
        "laravel message broker",
        "message broker",
        "php rabbitmq",
        "php kafka",
        "laravel kafka",
        "laravel rabbitmq",
        "kakaprodo"
    ],
    "require": {
        "php": ">=8.0",
        "laravel/framework": ">=8.0",
        "kakaprodo/custom-data": ">=2.3.3 || dev-develop",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Kakaprodo\\MessageBroker\\": "src/"
        }
    },
    "authors": [
        {
            "name": "promesse",
            "email": "promskakaprodo45@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Kakaprodo\\MessageBroker\\MessageBrokerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "license": "MIT"
}
